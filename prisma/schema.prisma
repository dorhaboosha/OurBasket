generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One shared list: no Household (spec 1.1, 16).
// Rules Prisma can't express (CHECK constraints, the system-category trigger) are in
// the migration SQL; see the comments there.

// ---- Users & authentication ----
// User, Session, Account and Verification are the core tables Better Auth expects.
// Only the two people in app.config.ts can have a user row (src/modules/auth/hooks.ts).

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  /// Which user from app.config.ts this is ("dor" / "maayan"). Set by the server only.
  configKey     String    @unique
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Google's tokens, encrypted by Better Auth (account.encryptOAuthTokens).
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// Unused: there is no email/password sign-in. Part of Better Auth's table.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Short-lived values for the OAuth flow (state, PKCE verifier).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

// ---- The shopping list ----

/// A product category. Exactly one is the system category "General" (isSystem): it
/// can't be deleted or lose that flag (database trigger), and catches products with
/// no category.
model Category {
  id             String    @id @default(uuid())
  name           String
  /// The name trimmed, with runs of spaces collapsed and lower-cased (src/lib/names.ts).
  normalizedName String    @unique
  /// A color key from appConfig.colorPalette.
  color          String
  /// An emoji.
  icon           String
  sortOrder      Int
  isSystem       Boolean   @default(false)
  /// Raised on every change; edits must send the version they loaded (optimistic locking).
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  products       Product[]

  @@index([sortOrder])
  @@map("category")
}

/// A product on the active list. Deleting is a hard delete (spec 8.5).
model Product {
  id             String   @id @default(uuid())
  /// A category with products can't be deleted: delete its products first, in the
  /// same transaction (spec 7.3).
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  /// Unique across the whole list, so the same product is never listed twice (spec 8.2).
  normalizedName String   @unique
  /// 1 to 999.
  quantity       Int      @default(1)
  isChecked      Boolean  @default(false)
  sortOrder      Int
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([categoryId, sortOrder])
  @@map("product")
}

/// A single row (id 1, enforced by a CHECK constraint) with the list's revision. Every
/// saved change raises it, and real-time events carry it (spec 12.2).
model ListState {
  id       Int @id @default(1)
  revision Int @default(0)

  @@map("list_state")
}

/// One "update list" action: the checked products that were bought.
model PurchaseRecord {
  id          String               @id @default(uuid())
  purchasedAt DateTime             @default(now()) @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  items       PurchaseRecordItem[]

  @@index([purchasedAt(sort: Desc)])
  @@map("purchase_record")
}

/// A product as it was when bought: a snapshot, not a link, so later changes to the
/// product or its category don't rewrite history (spec 9.2).
model PurchaseRecordItem {
  id               String         @id @default(uuid())
  purchaseRecordId String
  purchaseRecord   PurchaseRecord @relation(fields: [purchaseRecordId], references: [id], onDelete: Cascade)
  productName      String
  normalizedName   String
  quantity         Int
  /// The category's id at the time. Deliberately not a foreign key: it must survive the
  /// category being deleted, and "add to list" finds the category by it (spec 10.4).
  categoryId       String
  categoryName     String
  categoryColor    String
  categoryIcon     String

  @@index([purchaseRecordId])
  @@map("purchase_record_item")
}
