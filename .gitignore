# ---------------------------------------------
# Dependencies
# ---------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------
# Next.js / build output
# ---------------------------------------------
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Prisma client, generated on npm install (postinstall)
src/generated/

# ---------------------------------------------
# Testing
# ---------------------------------------------
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ---------------------------------------------
# Environment variables / secrets
# Never commit real secrets. Only .env.example is tracked.
# ---------------------------------------------
.env
.env*.local
.env.development
.env.production
.env.test
!.env.example
*.pem

# ---------------------------------------------
# Logs & debug
# ---------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ---------------------------------------------
# Deployment / tooling
# ---------------------------------------------
.vercel/
.render/
.turbo/
.eslintcache
.cache/

# ---------------------------------------------
# Editors & OS
# ---------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------
# Claude Code — keep personal/local settings out of git
# ---------------------------------------------
.claude/settings.local.json
