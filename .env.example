# =============================================================
# OurBasket — environment variables template
# Copy this file to `.env.local` (local dev) and fill in real values.
# On Render, set the same keys under Environment > Environment Variables.
# NEVER commit real values.
# =============================================================

# ---------- Database (Neon PostgreSQL) ----------
# Pooled connection string (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct (non-pooled) connection string — used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---------- Auth.js ----------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public base URL of the app (http://localhost:3000 locally, https://<app>.onrender.com in production)
AUTH_URL="http://localhost:3000"
# Required when running behind a proxy such as Render
AUTH_TRUST_HOST=true

# ---------- Google OAuth (Google Cloud Console > Credentials) ----------
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Access control ----------
# Comma-separated list of Google emails allowed to use the app
ALLOWED_EMAILS="first@example.com,second@example.com"

# ---------- Pusher Channels ----------
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
# Public values exposed to the browser (same key/cluster as above — NOT the secret)
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"
