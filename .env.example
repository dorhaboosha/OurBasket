# =============================================================
# OurBasket — environment variables template
# Copy to `.env` and fill in real values (Prisma and the tests read .env).
# Never commit the real file; it is git-ignored.
# On Vercel, set the same keys under Project > Settings > Environment Variables
# (separately for Production and Preview).
# Non-secret settings (locale, direction, time zone, user names, default
# categories, color palette) live in src/config/app.config.ts, not here.
# =============================================================

# ---- App ----
# Public base URL of the app (the Vercel URL in production). Read by Better Auth.
BETTER_AUTH_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Local development: Postgres 16 in Docker (npm run db:up, host port 5437) - both URLs are the same.
# Production (Neon, aws-eu-central-1): DATABASE_URL = pooled string (host contains "-pooler"),
#                                      DIRECT_URL   = direct string (used by Prisma migrations).
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/ourbasket
DIRECT_URL=postgresql://postgres:postgres@localhost:5437/ourbasket
# Integration tests only: separate database in the same Docker container.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5437/ourbasket_test

# ---- Authentication / sessions ----
# Signs session cookies. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me
# Google email of each allowed user: USER_EMAIL_<user key from app.config.ts, upper case>.
# Only these two accounts can sign in.
USER_EMAIL_DOR=dor@example.com
USER_EMAIL_MAAYAN=maayan@example.com

# ---- Google OAuth (sign-in only: openid, email, profile) ----
# Google Cloud project "OurBasket" > Google Auth Platform > Clients (type "Web application").
# Separate clients for local development and production.
# Redirect URI to register there: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# ---- Pusher Channels (real-time) ----
PUSHER_APP_ID=replace-me
PUSHER_KEY=replace-me
PUSHER_SECRET=replace-me
PUSHER_CLUSTER=eu
# Public values exposed to the browser (same key and cluster as above - never the secret).
NEXT_PUBLIC_PUSHER_KEY=replace-me
NEXT_PUBLIC_PUSHER_CLUSTER=eu
